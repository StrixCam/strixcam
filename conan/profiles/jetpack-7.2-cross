[settings]
os=Linux
arch=armv8
build_type=Release
compiler=gcc
compiler.version=13
compiler.libcxx=libstdc++11
compiler.cppstd=gnu20

[conf]
tools.build:compiler_executables={"c":"aarch64-linux-gnu-gcc-13","cpp":"aarch64-linux-gnu-g++-13"}

[buildenv]
CC=aarch64-linux-gnu-gcc-13
CXX=aarch64-linux-gnu-g++-13
